{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edu-os-slovenia.github.io/schema/topic.schema.json",
  "title": "Topic",
  "description": "Schema for a topic or subtopic within a curriculum.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "subject_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "curriculum_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_topic_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "grade": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "order": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "OFFICIAL",
        "AI_GENERATED",
        "ARCHIVED"
      ]
    }
  }
}
