{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edu-os-slovenia.github.io/schema/learning-objective.schema.json",
  "title": "Learning Objective",
  "description": "Schema for a learning objective within the Slovenian education system.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "topic_id",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "curriculum_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "grade": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "competency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "bloom_level": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "REMEMBER",
        "UNDERSTAND",
        "APPLY",
        "ANALYZE",
        "EVALUATE",
        "CREATE",
        null
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "OFFICIAL",
        "AI_GENERATED",
        "ARCHIVED"
      ]
    }
  }
}
